<!DOCTYPE html>

<html lang="ja">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>片付け・整理収納ブログ｜山梨・甲府の片付けサポート｜totonou（トトノウ）</title>
<meta content="山梨県の整理収納アドバイザー・内藤ちえこの公式ブログ。お家と心を整える片付けのヒントやマインドセット、日々の活動を綴ります。" name="description"/>
<link href="https://totonou.me/blog.html" rel="canonical"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&amp;family=M+PLUS+Rounded+1c:wght@400;500;700&amp;family=Noto+Sans+JP:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
<script defer="" src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
<style>
    /* ========================================
      🎨 カラー・フォント設定（index.htmlと完全同期）
    ======================================== */
    :root {
      --bg:        #ffffff;
      --bg-light:  #edf5fa;
      --accent:    #5ba3c2;
      --accent2:   #8ecae6;
      --accent3:   #2980a8;
      --text:      #333333; 
      --sub:       #456375;
      --line:      #d4e9f4;
      --line-light: #eee;
      --white:     #ffffff;
      --sans:      'Noto Sans JP', sans-serif;
      --rounded:   'M PLUS Rounded 1c', sans-serif;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    
    html, body { 
      max-width: 100vw;
      overflow-x: hidden; 
      scroll-behavior: smooth; 
    }

    img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
    }

    body {
      font-family: var(--sans);
      background: #ffffff;
      color: var(--text);
      font-size: clamp(14px, 2.5vw, 15px); 
      font-weight: 400; 
      line-height: 1.85;
    }

    .ib {
      display: inline-block;
      white-space: nowrap; 
    }
    @media (min-width: 769px) {
      .ib { white-space: normal; }
    }

    /* ========================================
       Header（共通パーツ）
    ======================================== */
    .header {
      position: fixed;
      top: 0; width: 100%;
      background: rgba(247, 251, 253, 0.95);
      backdrop-filter: blur(10px);
      z-index: 1000;
      padding: 12px 6%;
      box-shadow: 0 1px 10px rgba(0,0,0,0.02);
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--line-light);
    }
    .nav-logo {
      font-family: var(--rounded);
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    .nav-logo img {
      height: 45px;
      width: auto;
      vertical-align: middle;
      margin-right: 8px;
    }
    .nav-logo-text { display: flex; flex-direction: column; }
    .nav-logo-text div { font-size: clamp(1rem, 4vw, 1.3rem); font-weight: 700; line-height: 1; }
    .nav-logo span { font-size: clamp(0.6rem, 2vw, 0.75rem); font-family: var(--sans); font-weight: 400; letter-spacing: 0.1em; color: var(--sub); display: block; margin-top: 2px; }
    
    .header-tel {
      margin-left: auto;
      margin-right: clamp(10px, 3vw, 30px);
      text-decoration: none;
      color: var(--accent3);
      font-weight: 700;
      font-size: clamp(0.85rem, 3vw, 1.1rem);
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0; 
    }
    .header-tel svg { width: 1em; height: 1em; }

    .menu-btn {
      background: none; border: none; cursor: pointer; z-index: 1100; width: 30px; height: 24px; display: flex; flex-direction: column; justify-content: space-between;
    }
    .menu-btn span { display: block; width: 100%; height: 2px; background-color: var(--accent); transition: all 0.3s; }
    .menu-btn.active span:nth-child(1) { transform: translateY(11px) rotate(45deg); }
    .menu-btn.active span:nth-child(2) { opacity: 0; }
    .menu-btn.active span:nth-child(3) { transform: translateY(-11px) rotate(-45deg); }

    .nav-menu {
      position: fixed; top: 0; right: 0; transform: translateX(100%); visibility: hidden; width: 250px; height: 100vh; background: rgba(247, 251, 253, 0.98); box-shadow: -5px 0 20px rgba(0,0,0,0.1); transition: transform 0.4s ease, visibility 0.4s; z-index: 1050; padding-top: 80px;
    }
    .nav-menu.active { transform: translateX(0); visibility: visible; }
    .nav-menu ul { list-style: none; text-align: left; padding: 0 30px; }
    .nav-menu ul li { margin-bottom: 25px; border-bottom: 1px solid var(--line-light); padding-bottom: 10px; }
    .nav-menu ul li a { text-decoration: none; color: var(--text); font-size: 1rem; font-weight: 500; display: block; transition: color 0.3s; }
    .nav-menu ul li a:hover { color: var(--accent); }

    /* ========================================
       Main Content Area（ブログ一覧）
    ======================================== */
    .main-layout {
      padding: 140px 6% 60px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .page-title {
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-family: var(--rounded);
      font-weight: 700;
      color: var(--text);
      text-align: center;
      margin-bottom: 10px;
    }
    .page-lead {
      text-align: center;
      color: #000000;
      font-size: 0.95rem;
      margin-bottom: 50px;
    }

    /* グリッドレイアウト */
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 35px 25px;
    }

    /* ブログカード共通設定 */
    .blog-card {
      background: var(--white);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.02);
      border: 1px solid #000;
      text-decoration: none;
      color: var(--text);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .blog-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    }

    .blog-img-wrap {
      position: relative;
      width: 100%;
      padding-top: 60%; /* 5:3のアスペクト比 */
      overflow: hidden;
      background: var(--bg-light);
    }
    .blog-img-wrap img {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      border-radius: 0;
    }

    .blog-category {
      position: absolute;
      top: 15px; left: 15px;
      background: rgba(255, 255, 255, 0.95);
      color: var(--accent3);
      padding: 3px 12px;
      font-size: 0.75rem;
      font-weight: 700;
      border-radius: 4px;
      z-index: 10;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .blog-content {
      padding: 22px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .blog-meta {
      font-size: 0.85rem;
      color: var(--sub);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .blog-meta svg {
      color: var(--accent);
    }

    .blog-title {
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.5;
      min-height: calc(1.15rem * 1.5 * 2);
      margin-bottom: 12px;
      color: var(--text);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .blog-excerpt {
      font-size: 0.9rem;
      color: #666;
      line-height: 1.6;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }


    /* ブログ絞り込み・検索 */
    .blog-tools {
      max-width: 900px;
      margin: 0 auto 35px;
      background: var(--white);
      border: 1px solid var(--line-light);
      border-radius: 12px;
      padding: 22px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .blog-search {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 12px 18px;
      font-family: var(--sans);
      font-size: 0.95rem;
      color: var(--text);
      background: #ffffff;
      outline: none;
      margin-bottom: 16px;
    }

    .blog-search:focus {
      border-color: var(--accent);
      background: var(--white);
    }

    .blog-tool-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      justify-content: space-between;
    }

    .blog-filter-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .blog-filter-btn {
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--accent3);
      border-radius: 999px;
      padding: 7px 14px;
      font-family: var(--sans);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .blog-filter-btn.active,
    .blog-filter-btn:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--white);
    }

    .blog-sort {
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 7px 14px;
      font-family: var(--sans);
      font-size: 0.85rem;
      color: var(--text);
      background: var(--white);
      outline: none;
    }

    .blog-result-count {
      margin-top: 12px;
      color: var(--sub);
      font-size: 0.85rem;
      text-align: right;
    }

    .blog-card.hidden {
      display: none;
    }

    /* ========================================
       Footer
    ======================================== */
    .footer { background: var(--text); color: var(--white); text-align: center; padding: 40px 20px; border-top: 1px solid rgba(255,255,255,0.1); }
    .footer p { font-size: 0.95rem; color: rgba(255,255,255,0.8); margin: 5px 0; letter-spacing: 0.05em; }

    /* レスポンシブ調整 */
    @media (max-width: 768px) {
      .header { padding: 10px 12px; }
      .nav-logo img { height: 28px; margin-right: 6px; }
      .nav-logo-text div { font-size: 1.05rem; }
      .nav-logo span { font-size: 0.55rem; letter-spacing: 0; white-space: nowrap; }
      .header-tel { margin-right: 5px; font-size: 0.75rem; gap: 3px; }
      .menu-btn { width: 24px; }
      .nav-menu { width: 80%; } 

      .main-layout { padding: 110px 4% 40px; }
      .page-lead { margin-bottom: 35px; }
      .blog-grid { grid-template-columns: 1fr; gap: 30px; }
      .blog-content { padding: 18px; }
      .blog-title { font-size: 1.1rem; }

      .blog-tools { padding: 18px; margin-bottom: 28px; }
      .blog-tool-row { align-items: stretch; }
      .blog-filter-buttons { width: 100%; }
      .blog-filter-btn { flex: 1 1 auto; }
      .blog-sort { width: 100%; margin-top: 2px; }
      .blog-result-count { text-align: left; }
    }
  

.header-blog-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  margin-right: 28px;
  margin-left: 18px;
  flex-shrink: 0;
  transition: opacity 0.3s ease;
}

.header-blog-btn:hover {
  opacity: 0.75;
}

.header-blog-btn .blog-icon-circle {
  width: 36px;
  height: 36px;
  border-radius: 4px !important;
  background: var(--bg-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-blog-btn i,
.header-blog-btn svg {
  color: var(--accent3);
  font-size: 0.95rem;
  width: 1em;
  height: 1em;
}

@media (max-width: 768px) {
  .header-blog-btn {
    margin-left: 0;
    margin-right: 10px;
  }

  .header-blog-btn .blog-icon-circle {
    width: 34px;
    height: 34px;
  }

  .header-blog-btn i,
  .header-blog-btn svg {
    font-size: 0.9rem;
  }
}

/* ===== blog list requested final adjustments ===== */
html, body { background: #ffffff !important; }
body { background: #ffffff !important; }
.main-layout { background: #ffffff !important; }
.blog-tools, .blog-search, .blog-tool-row, .blog-filter-buttons, .blog-filter-btn, .blog-sort, .blog-result-count { display: none !important; }
.header-blog-btn .blog-icon-circle {
  width: 36px !important; height: 36px !important; border-radius: 4px !important;
  background: var(--bg-light) !important; color: var(--accent3) !important;
  display:flex !important; align-items:center !important; justify-content:center !important;
  font-size:0.62rem !important; font-weight:700 !important; font-family:var(--sans) !important;
}
.header-blog-btn i, .header-blog-btn svg { display:none !important; }
@media (max-width: 768px) {
  .nav-menu { padding-top: 58px !important; }
  .nav-menu ul { padding: 0 24px !important; }
  .nav-menu ul li { margin-bottom: 10px !important; padding-bottom: 6px !important; }
  .nav-menu ul li a { font-size: 0.88rem !important; line-height: 1.35 !important; }
  .header-blog-btn { margin-left:0 !important; margin-right:10px !important; }
  .header-blog-btn .blog-icon-circle { width:34px !important; height:34px !important; font-size:0.58rem !important; }
}


/* requested header blog text black */
.header-blog-btn .blog-icon-circle {
  color: #222 !important;
border: 1px solid #222 !important;
}
.header-blog-btn .blog-icon-circle::after {
  color: #222 !important;
}



.blog-body h2.article-subheading {
  font-size: clamp(1.05rem, 2.3vw, 1.28rem) !important;
  font-weight: 700 !important;
  line-height: 1.5 !important;
}



time { color: #000 !important; }
.article-date, .post-date, .blog-date { color: #000 !important; }
</style>
</head>
